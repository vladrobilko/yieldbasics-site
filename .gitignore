# build output
dist/
.output/
.astro/

# dependencies
node_modules/

# test output
coverage/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables and secrets — this repo is PUBLIC.
# Only .env.example (with no real values) may be committed.
.env
.env.*
!.env.example
*.pem
*.key

# local-only AI agent files (shared rules in AGENTS.md, CLAUDE.md,
# .agents/ and .claude/settings.json ARE committed)
.claude/settings.local.json
.claude/**/memory/
CLAUDE.local.md

# local hosting CLI state
.vercel/
.netlify/
.wrangler/

# editors and OS
.idea/
*.local
.DS_Store
Thumbs.db

# pnpm-specific files: pnpm is supported for local use (see .pnpmrc), but
# package-lock.json is the tracked lockfile and npm is what CI and the
# GitHub Pages build run. Committing these would let the two trees diverge.
pnpm-lock.yaml
pnpm-workspace.yaml
