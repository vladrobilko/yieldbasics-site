---
import Layout from '~/layouts/PageLayout.astro';

import { Icon } from 'astro-icon/components';
import YieldRates from '~/components/widgets/YieldRates.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import { platforms } from '~/data/platforms';
import { assets, rateRows, ratesUpdatedAt } from '~/data/yields';
import { assetSlug, assetsWithOffers } from '~/utils/assetPages';
import { getPermalink } from '~/utils/permalinks';
import { formatRateDate } from '~/utils/rates';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';

const metadata = {
  title: `${SITE?.name} — Compare crypto earn rates`,
  description: `Compare crypto earn rates (APR / APY) across ${platforms.length} exchanges, DeFi and wallets for USDT, BTC, ETH and ${assets.length - 3} more coins. Updated daily.`,
  ignoreTitleTemplate: true,
};

// Structured data for the site and its publisher, built only from
// `src/config.yaml` (`site.name`, `site.site`, `metadata.twitter.handle`).
// Blog posts add BlogPosting on their own; the FAQs widget adds FAQPage.
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    // Raster logo (Google prefers PNG/JPG, at least 112×112), from public/.
    logo: new URL('/icon-512.png', SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];

// Coin pages and FAQ (SEO): links to every /rates/<coin> page, plus common
// questions with FAQPage structured data.
const coinPages = assetsWithOffers(assets, rateRows);
const heroIntro = `Compare savings and staking rates for USDT, BTC, ETH and ${assets.length - 3} more coins across ${platforms.length} exchanges, DeFi protocols and wallets, updated every day.`;
const faq = [
  {
    title: 'What is the difference between APR and APY?',
    description:
      'APR is the simple yearly rate. APY includes compounding, the interest earned on your interest, so 5% APY pays slightly less than 5% APR. Most exchanges quote APR, while DeFi protocols such as Aave usually quote APY. The table shows which one each offer uses, and our <a href="/apr-to-apy-calculator">APR to APY calculator</a> converts between them.',
  },
  {
    title: 'How often are the rates updated?',
    description:
      "Every day. We read each platform's published earn rates automatically. A few platforms only show their rates to signed-in users; we check those by hand and mark them with the date we checked.",
  },
  {
    title: 'Flexible or fixed term: which should I choose?',
    description:
      'Flexible products let you withdraw at any time, and the rate can change daily. Fixed terms lock your coins for a set number of days, often for a higher rate, but you usually lose the interest if you withdraw early.',
  },
  {
    title: 'What are new-user offers?',
    description:
      'Some platforms pay a very high APR, sometimes hundreds of percent, on a small amount for a few days to attract new accounts. Because they are capped and short, we list them in their own "New users" tab and rank them by the total you can earn, not by APR. See <a href="/guides/new-user-crypto-earn-offers">what new-user offers really pay</a>.',
  },
  {
    title: 'How does YieldBasics make money?',
    description:
      '"View offer" buttons are referral links: we may earn a commission when you sign up through them, at no extra cost to you. It never affects the ranking, which is always by rate.',
  },
  {
    title: 'Is earning interest on crypto safe?',
    description:
      'It carries real risk: platforms can fail, pause withdrawals or change terms, and DeFi protocols can have smart-contract bugs. Spread your deposits, read the terms of each offer, and only deposit what you can afford to lose. Read more in <a href="/guides/is-crypto-earn-safe">is crypto earn safe?</a> Nothing here is financial advice.',
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <div class="mx-auto w-full max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <section class="pt-12 sm:pt-16" aria-labelledby="page-title">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-emerald-700 dark:text-emerald-400">
            Crypto savings and staking rates
          </p>
          <h1
            id="page-title"
            class="text-4xl font-extrabold tracking-[-0.04em] text-slate-950 sm:text-5xl dark:text-white"
          >
            Compare Crypto Earn Rates
          </h1>
          <p class="mt-4 max-w-xl text-base leading-7 text-slate-600 dark:text-slate-300">
            {heroIntro}
          </p>
        </div>
        <div
          class="flex items-center gap-2 self-start rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-500 shadow-sm md:self-end dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400"
        >
          <Icon name="tabler:clock-check" class="h-3.5 w-3.5 text-emerald-700 dark:text-emerald-400" />
          <span>Updated daily · last update {formatRateDate(ratesUpdatedAt)}</span>
        </div>
      </div>
    </section>

    <YieldRates />

    <section class="mt-12" aria-labelledby="coins-heading">
      <h2 id="coins-heading" class="text-lg font-bold tracking-tight text-slate-950 dark:text-white">Rates by coin</h2>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        Every offer for one coin on its own page, with flexible, fixed-term and new-user deals listed separately.
      </p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          coinPages.map((coin) => (
            <li>
              <a
                href={getPermalink(`/rates/${assetSlug(coin.symbol)}`)}
                class="inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-sm font-semibold text-slate-700 transition hover:border-emerald-500 hover:text-emerald-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:text-emerald-400"
              >
                {coin.symbol} rates
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <aside
      class="mt-8 flex items-center gap-3 rounded-xl border border-emerald-100 bg-emerald-50/70 px-5 py-4 text-sm text-emerald-950 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-100"
    >
      <Icon name="tabler:sparkles" class="h-5 w-5 shrink-0 text-emerald-600" />
      <p>
        <strong>New to earning?</strong> Flexible products let you withdraw at any time, while fixed terms may offer a higher
        rate.
      </p>
    </aside>
  </div>

  <FAQs id="faq" title="Questions about crypto earn rates" items={faq} schema />
</Layout>
