---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';

const metadata = {
  title: `${SITE?.name} — Yields in crypto, stocks and beyond, explained simply`,
  ignoreTitleTemplate: true,
};

// Structured data for the site and its publisher, built only from
// `src/config.yaml` (`site.name`, `site.site`, `metadata.twitter.handle`).
// Blog posts add BlogPosting on their own; the FAQs widget adds FAQPage.
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <Hero
    tagline="Coming soon"
    actions={[
      { variant: 'primary', text: 'Read the blog', href: getBlogPermalink() },
      { text: 'About', href: getPermalink('/about') },
    ]}
  >
    <Fragment slot="title">
      Understand <span class="text-accent dark:text-white">yields</span>, before you chase them
    </Fragment>

    <Fragment slot="subtitle">
      Plain-language guides and simple tools for yields in crypto, stocks and beyond.
    </Fragment>
  </Hero>

  <Features
    id="features"
    title="What YieldBasics will cover"
    columns={3}
    items={[
      {
        title: 'Crypto yields',
        description: 'Staking, lending and liquidity — where the returns come from and what can go wrong.',
        icon: 'tabler:currency-bitcoin',
      },
      {
        title: 'Stocks and bonds',
        description: 'Dividends, bond coupons and other classic income, explained without jargon.',
        icon: 'tabler:chart-line',
      },
      {
        title: 'Tools',
        description: 'Calculators and comparisons to see what a yield really means over time.',
        icon: 'tabler:calculator',
      },
    ]}
  />

  <BlogLatestPosts title="Latest articles" count={4} />
</Layout>
