---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { deals } from '~/data/deals';
import { getPlatform } from '~/data/platforms';
import { rateRows } from '~/data/yields';
import { assetSlug } from '~/utils/assetPages';
import { dealKindLabels, formatDealTime, platformHighlights, timeLeftLabel, visibleDeals } from '~/utils/deals';
import { formatRateDate } from '~/utils/rates';
import { getPermalink } from '~/utils/permalinks';
import { formatRate } from '~/utils/yields';

// Short-lived offers (launchpads, airdrops, sign-up bonuses) from
// src/data/deals.json. Ended deals are left out at build time; the script
// below hides any that end between rebuilds, keeps the countdowns current and
// drives the "Details" toggle that phones use to open a card's conditions.

const now = new Date();
// Each card also links to the platform's best new-user and everyday earn
// offers from the daily rates, so it stays current without editing.
const cards = visibleDeals(deals, now).map((deal) => ({
  ...deal,
  platform: getPlatform(deal.platformId),
  more: platformHighlights(rateRows, deal.platformId),
}));

const metadata = {
  title: 'Crypto deals: launchpads, airdrops and bonuses',
  description:
    cards.length > 0
      ? `Live crypto deals: ${cards.map((c) => `${c.platform.name} ${c.asset} ${c.headline}`).join(', ')}. Conditions, end dates and links.`
      : 'Limited-time crypto deals, such as discounted launchpad sales, airdrops and sign-up bonuses, with their conditions and end dates.',
  // An empty page isn't worth indexing; it comes back with the next live deal.
  ...(cards.length === 0 ? { robots: { index: false } } : {}),
};

const schema = cards.map((card) => ({
  '@context': 'https://schema.org',
  '@type': 'Offer',
  name: `${card.platform.name} ${card.title}`,
  description: `${card.headline}. ${card.conditions.join('. ')}.`,
  url: card.url ?? card.platform.referralUrl,
  availabilityStarts: card.startsAt,
  validThrough: card.endsAt,
  seller: { '@type': 'Organization', name: card.platform.name, url: card.platform.website },
}));
---

<Layout metadata={metadata}>
  {schema.length > 0 && <StructuredData slot="head" schema={schema} />}

  <div class="mx-auto w-full max-w-5xl px-4 pb-20 pt-10 sm:px-6 lg:px-8">
    <header class="text-center">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl dark:text-white">Crypto deals</h1>
      <p class="mt-2 text-base text-slate-600 dark:text-slate-400">Limited-time offers</p>
    </header>

    <yb-deals class="mt-8 block">
      <ul class="flex flex-wrap justify-center gap-5">
        {
          cards.map((card) => (
            <li
              id={card.id}
              data-deal
              data-starts={card.startsAt}
              data-ends={card.endsAt}
              class="w-full max-w-md scroll-mt-24 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_8px_30px_rgba(15,23,42,0.06)] target:border-emerald-500 target:ring-2 target:ring-emerald-500/30 dark:border-slate-800 dark:bg-slate-900"
            >
              <div class="p-5">
                <div class="flex items-center justify-between gap-3">
                  <div class="flex items-center gap-2.5">
                    {card.platform.logo ? (
                      <span
                        class="h-8 w-8 shrink-0 overflow-hidden rounded-full ring-1 ring-slate-200 dark:ring-slate-700"
                        aria-hidden="true"
                      >
                        <Icon name={card.platform.logo} class="h-full w-full" />
                      </span>
                    ) : (
                      <span
                        class:list={[
                          'flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-extrabold',
                          card.platform.markClass,
                        ]}
                        aria-hidden="true"
                      >
                        {card.platform.mark}
                      </span>
                    )}
                    <p class="text-sm font-bold text-slate-900 dark:text-white">
                      {card.platform.name}
                      <span class="font-semibold text-slate-400"> · {dealKindLabels[card.kind]}</span>
                    </p>
                  </div>
                  {card.audience === 'new-user' && (
                    <span class="rounded-md bg-amber-50 px-2 py-1 text-[11px] font-bold text-amber-800 ring-1 ring-inset ring-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:ring-amber-900">
                      New users
                    </span>
                  )}
                </div>

                <h2 class="mt-4 text-2xl font-extrabold tracking-tight text-slate-950 dark:text-white">{card.title}</h2>
                <p class="mt-1 inline-flex items-center gap-1.5 text-sm font-semibold text-slate-600 dark:text-slate-300">
                  <Icon name="tabler:clock" class="h-4 w-4 text-emerald-600 dark:text-emerald-400" />
                  <span data-countdown aria-live="polite">
                    {timeLeftLabel(card, now)}
                  </span>
                </p>

                {card.stats && card.stats.length > 0 && (
                  <dl class="mt-4 grid grid-cols-3 divide-x divide-slate-100 rounded-xl bg-slate-50 py-3 text-center dark:divide-slate-800 dark:bg-slate-800/50">
                    {card.stats.map((stat, index) => (
                      <div class="px-2">
                        <dt class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
                          {stat.label}
                        </dt>
                        <dd
                          class:list={[
                            'mt-1 text-sm font-extrabold tabular-nums',
                            index === 0 ? 'text-emerald-700 dark:text-emerald-400' : 'text-slate-900 dark:text-white',
                          ]}
                        >
                          {stat.value}
                        </dd>
                      </div>
                    ))}
                  </dl>
                )}

                <button
                  type="button"
                  data-details-toggle
                  aria-expanded="false"
                  aria-controls={`${card.id}-details`}
                  class="mt-4 flex w-full items-center justify-center gap-1 rounded-lg py-2 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-50 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 md:hidden dark:text-emerald-400 dark:hover:bg-emerald-950/40"
                >
                  <span data-details-label>Details</span>
                  <Icon name="tabler:chevron-down" class="h-4 w-4 transition-transform" data-details-icon />
                </button>

                <div id={`${card.id}-details`} data-details class="hidden md:block">
                  <ul class="mt-4 space-y-2 text-sm text-slate-700 dark:text-slate-300">
                    {card.conditions.map((condition) => (
                      <li class="flex gap-2">
                        <Icon
                          name="tabler:check"
                          class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600 dark:text-emerald-400"
                        />
                        {condition}
                      </li>
                    ))}
                  </ul>
                  <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">
                    Ends {formatDealTime(card.endsAt)} · Checked {formatRateDate(card.verifiedAt)}
                  </p>
                </div>

                <a
                  href={card.url ?? card.platform.referralUrl}
                  target="_blank"
                  rel="sponsored nofollow noopener"
                  class="group/cta mt-5 flex items-center justify-center gap-2 rounded-xl bg-emerald-600 px-4 py-3.5 text-base font-bold text-white shadow-lg shadow-emerald-600/25 transition hover:-translate-y-0.5 hover:bg-emerald-500 hover:shadow-emerald-500/30 focus:outline-none focus:ring-4 focus:ring-emerald-500/30 active:translate-y-0 dark:bg-emerald-500 dark:text-slate-950 dark:hover:bg-emerald-400"
                >
                  Get the deal
                  <Icon name="tabler:arrow-right" class="h-5 w-5 transition-transform group-hover/cta:translate-x-1" />
                </a>
              </div>

              {card.more.length > 0 && (
                <div class="border-t border-slate-100 bg-slate-50/60 px-5 py-4 dark:border-slate-800 dark:bg-slate-800/30">
                  <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">
                    More on {card.platform.name}
                  </p>
                  <ul class="mt-2 space-y-1.5">
                    {card.more.map((row) => (
                      <li>
                        <a
                          href={getPermalink(`/rates/${assetSlug(row.asset)}`) + `#offer-${row.id}`}
                          class="group/more flex items-center justify-between gap-3 rounded-lg px-2 py-1.5 text-sm transition hover:bg-white dark:hover:bg-slate-800"
                        >
                          <span class="text-slate-700 dark:text-slate-300">
                            <span class="font-bold text-slate-900 dark:text-white">{row.asset}</span>{' '}
                            {row.audience === 'new-user' ? 'for new users' : row.term.toLowerCase()}
                          </span>
                          <span class="inline-flex items-center gap-1 font-bold tabular-nums text-emerald-700 dark:text-emerald-400">
                            {formatRate(row.rate)} {row.type}
                            <Icon
                              name="tabler:chevron-right"
                              class="h-4 w-4 transition-transform group-hover/more:translate-x-0.5"
                            />
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ul>

      <div
        data-deals-empty
        hidden={cards.length > 0}
        class="mx-auto max-w-md rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center dark:border-slate-700 dark:bg-slate-900"
      >
        <Icon name="tabler:hourglass-empty" class="mx-auto h-8 w-8 text-slate-400" />
        <p class="mt-3 font-semibold text-slate-900 dark:text-white">No live deals right now</p>
        <a
          href={getPermalink('/')}
          class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-emerald-700 hover:underline dark:text-emerald-400"
        >
          <Icon name="tabler:table" class="h-4 w-4" /> See today's earn rates
        </a>
      </div>
    </yb-deals>

    <p class="mx-auto mt-8 max-w-md text-center text-xs leading-5 text-slate-500 dark:text-slate-400">
      New tokens can trade below the sale price. Check the platform's rules and your country's eligibility. Links are
      referral links. Not financial advice.
    </p>
  </div>
</Layout>

<script>
  import { hasEnded, timeLeftLabel } from '~/utils/deals';

  class YbDeals extends HTMLElement {
    private timer?: number;

    connectedCallback() {
      const cards = Array.from(this.querySelectorAll<HTMLElement>('[data-deal]'));
      const empty = this.querySelector<HTMLElement>('[data-deals-empty]');

      const update = () => {
        const now = new Date();
        for (const card of cards) {
          const deal = { startsAt: card.dataset.starts ?? '', endsAt: card.dataset.ends ?? '' };
          card.hidden = hasEnded(deal, now);
          const countdown = card.querySelector('[data-countdown]');
          if (countdown) countdown.textContent = timeLeftLabel(deal, now);
        }
        if (empty) empty.hidden = cards.some((card) => !card.hidden);
      };
      update();
      this.timer = window.setInterval(update, 30_000);

      // Phones: "Details" opens the conditions (always shown from md up).
      for (const card of cards) {
        const toggle = card.querySelector<HTMLButtonElement>('[data-details-toggle]');
        const details = card.querySelector<HTMLElement>('[data-details]');
        if (!toggle || !details) continue;
        toggle.addEventListener('click', () => {
          const open = toggle.getAttribute('aria-expanded') !== 'true';
          toggle.setAttribute('aria-expanded', String(open));
          details.classList.toggle('hidden', !open);
          const label = toggle.querySelector('[data-details-label]');
          if (label) label.textContent = open ? 'Hide details' : 'Details';
          toggle.querySelector('[data-details-icon]')?.classList.toggle('rotate-180', open);
        });
      }
    }

    disconnectedCallback() {
      window.clearInterval(this.timer);
    }
  }

  if (!customElements.get('yb-deals')) {
    customElements.define('yb-deals', YbDeals);
  }
</script>
