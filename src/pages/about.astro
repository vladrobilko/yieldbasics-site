---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getBlogPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'About',
  description: 'YieldBasics explains how yields work across crypto, stocks and other assets — in plain language.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="About"
    title="Yields, explained simply"
    subtitle="YieldBasics is a place to understand where returns come from — staking, lending, dividends, bonds and more — and how to compare them honestly."
  />

  <Features2
    title="What you will find here"
    columns={3}
    items={[
      {
        title: 'Plain-language guides',
        description: 'Clear explanations of how each kind of yield is generated and what the risks are.',
        icon: 'tabler:book',
      },
      {
        title: 'Tools and calculators',
        description: 'Simple tools to compare yields and see what a rate really means over time.',
        icon: 'tabler:calculator',
      },
      {
        title: 'Crypto and traditional markets',
        description: 'Side-by-side look at on-chain yields and classic income investments.',
        icon: 'tabler:chart-line',
      },
    ]}
  />

  <CallToAction
    title="Start reading"
    subtitle="New articles are on the way."
    actions={[{ variant: 'primary', text: 'Go to the blog', href: getBlogPermalink() }]}
  />
</Layout>
