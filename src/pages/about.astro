---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { platforms } from '~/data/platforms';
import { assets } from '~/data/yields';
import manualRates from '~/data/manual-rates.json';
import { getPermalink } from '~/utils/permalinks';

// Counts and names come from the data so this page stays accurate as platforms and assets are added.
const platformCount = platforms.length;
const assetCount = assets.length;
const list = (names: string[]) => new Intl.ListFormat('en', { type: 'conjunction' }).format(names);
const manualIds = new Set(manualRates.offers.map((o) => o.platformId));
const manualNames = platforms.filter((p) => manualIds.has(p.id)).map((p) => p.name);
const exchangeNames = platforms.filter((p) => p.kind === 'cex' && !manualIds.has(p.id)).map((p) => p.name);

const metadata = {
  title: 'About',
  description: `YieldBasics compares crypto earn rates (APR / APY) across ${platformCount} exchanges, DeFi and wallets — updated daily, ranked by rate.`,
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="About"
    title="Crypto earn rates, side by side"
    subtitle={`YieldBasics is an independent comparison of crypto earn rates. We collect the savings, staking and fixed-term rates of ${platformCount} platforms for ${assetCount} coins and stablecoins, and put them in one table so you can see where your assets earn the most.`}
  />

  <Features2
    title="How it works"
    columns={3}
    items={[
      {
        title: 'Rates from the source, daily',
        description: `Once a day we read the rates that ${list(exchangeNames)} publish through their public APIs, and Aave's rates from DefiLlama's public DeFi data. ${list(manualNames)} only show rates to signed-in users, so we check those by hand and show the date we checked.`,
        icon: 'tabler:clock-check',
      },
      {
        title: 'How we pick platforms',
        description:
          'We list exchanges, DeFi protocols and wallets that offer earn products to a wide audience and whose rates we can check reliably. Most have a referral program; that never moves them up the table.',
        icon: 'tabler:list-check',
      },
      {
        title: 'Flexible, fixed and new-user offers',
        description:
          'Filter by flexible or fixed terms. Offers only for new accounts sit in their own tab, ranked by what you can actually earn, so huge capped APRs never distort the main ranking.',
        icon: 'tabler:filter',
      },
      {
        title: 'Ranked by rate, nothing else',
        description:
          'The table is always sorted by rate (or by estimated reward for new-user offers). No platform pays to be listed higher.',
        icon: 'tabler:sort-descending',
      },
      {
        title: 'How we make money',
        description:
          '"View offer" buttons are referral links: we may earn a commission when you sign up through them, at no extra cost to you. We also show one labeled ad at the top of the page. Neither ever changes the order of the table.',
        icon: 'tabler:link',
      },
      {
        title: 'Not financial advice',
        description:
          'Rates change, vary by region and account tier, and every platform carries its own risks. Always read the offer terms on the platform before you deposit.',
        icon: 'tabler:alert-circle',
      },
    ]}
  />

  <CallToAction
    title="Spotted a wrong rate or a missing platform?"
    subtitle="Tell us — corrections and suggestions make the table better for everyone."
    actions={[
      { variant: 'primary', text: 'Compare rates', href: getPermalink('/'), icon: 'tabler:table' },
      { variant: 'secondary', text: 'Contact us', href: getPermalink('/contact') },
    ]}
  />
</Layout>
