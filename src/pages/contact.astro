---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';

const metadata = {
  title: 'Contact',
  description: 'Get in touch with YieldBasics: questions, corrections and suggestions for new topics.',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Contact" title="Get in touch" />

  <ContactUs
    id="form"
    title="Send us a message"
    subtitle="Questions, corrections or ideas for a topic we should cover — we read every message."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
    ]}
    textarea={{
      label: 'Message',
    }}
    disclaimer={{
      label: 'By submitting this form, you agree that we may use your email address to reply to your message.',
    }}
  />
</Layout>
