---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-plex`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
//
// Colours follow the YieldBasics design from Figma: slate neutrals with an
// emerald accent (Tailwind emerald-500/600/700, slate-50…950).
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-plex);
    --aw-font-serif: var(--font-plex);
    --aw-font-heading: var(--font-plex);

    /* emerald-700 / -800: white text on primary buttons meets WCAG AA (5.5:1). */
    --aw-color-primary: rgb(4 120 87);
    --aw-color-secondary: rgb(6 95 70);
    --aw-color-accent: rgb(16 185 129);

    --aw-color-text-heading: rgb(2 6 23);
    --aw-color-text-default: rgb(15 23 42);
    --aw-color-text-muted: rgb(71 85 105);
    --aw-color-bg-page: rgb(248 250 252);

    --aw-color-bg-page-dark: rgb(2 6 23);

    ::selection {
      background-color: rgb(209 250 229);
    }
  }

  .dark {
    --aw-font-sans: var(--font-plex);
    --aw-font-serif: var(--font-plex);
    --aw-font-heading: var(--font-plex);

    --aw-color-primary: rgb(16 185 129);
    --aw-color-secondary: rgb(5 150 105);
    --aw-color-accent: rgb(52 211 153);

    --aw-color-text-heading: rgb(248 250 252);
    --aw-color-text-default: rgb(226 232 240);
    --aw-color-text-muted: rgb(148 163 184);
    --aw-color-bg-page: rgb(2 6 23);

    ::selection {
      background-color: rgb(6 78 59);
      color: rgb(236 253 245);
    }
  }
</style>
