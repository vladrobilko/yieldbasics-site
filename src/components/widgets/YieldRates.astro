---
import { Icon } from 'astro-icon/components';
import AssetChip from '~/components/ui/AssetChip.astro';
import YieldBadge from '~/components/ui/YieldBadge.astro';
import { assets, coinAssets, DEFAULT_ASSET_ID, mainAssets, rateRows, stablecoinAssets } from '~/data/yields';
import { productsLabel, ratesForAsset, sortByRate, sortLabel } from '~/utils/yields';

// Asset picker + sortable rates table from the YieldBasics MagicPath design.
// Every row is rendered at build time (static site); the small script below
// only filters by asset, flips the sort order and drives the "···" popover.

const defaultAsset = assets.find((a) => a.id === DEFAULT_ASSET_ID) ?? assets[0];
const defaultRows = ratesForAsset(rateRows, defaultAsset.symbol);
const allRows = sortByRate(rateRows);
const moreAssets = [...stablecoinAssets, ...coinAssets];
const moreGroups = [
  { id: 'stablecoin', title: 'Stablecoins', items: stablecoinAssets },
  { id: 'coin', title: 'Other coins', items: coinAssets },
];
---

<yb-yield-rates data-default-asset={defaultAsset.symbol}>
  <section class="mt-10" aria-labelledby="asset-heading">
    <div class="flex items-center justify-between gap-4">
      <div>
        <h2 id="asset-heading" class="text-sm font-bold text-slate-900 dark:text-white">Choose an asset</h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Showing the highest available yield first</p>
      </div>
      <span class="hidden items-center gap-1 text-xs text-slate-400 sm:flex">
        <Icon name="tabler:shield-check" class="h-3.5 w-3.5" /> Rates will be checked daily
      </span>
    </div>

    <div class="w-full overflow-x-auto py-4 [scrollbar-width:none]">
      <div class="flex min-w-max items-center gap-3">
        {
          mainAssets.map((asset) => (
            <AssetChip
              asset={asset}
              pressed={asset.symbol === defaultAsset.symbol}
              data-asset-button
              data-symbol={asset.symbol}
            />
          ))
        }
        {
          /* One pre-rendered chip per popover asset; the picked one is shown as the 6th chip. */
          moreAssets.map((asset) => (
            <AssetChip asset={asset} data-asset-button data-extra data-symbol={asset.symbol} hidden />
          ))
        }
        <button
          type="button"
          popovertarget="more-assets"
          data-more-button
          class="flex items-center justify-center rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-bold text-slate-400 transition-all duration-200 hover:border-slate-300 hover:bg-slate-50 hover:text-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 dark:border-slate-800 dark:bg-slate-900 dark:hover:bg-slate-800"
          aria-label="More assets"
          title="More assets"
        >
          <span aria-hidden="true" class="text-lg leading-8 tracking-[0.16em]">···</span>
        </button>
      </div>
    </div>

    <div
      id="more-assets"
      popover
      role="dialog"
      aria-label="More assets"
      class="m-0 max-h-[min(30rem,75vh)] w-[min(26rem,calc(100vw-2rem))] overflow-y-auto rounded-xl border border-slate-200 bg-white p-4 text-slate-900 shadow-xl dark:border-slate-700 dark:bg-slate-900 dark:text-white"
    >
      <label class="relative block">
        <span class="sr-only">Search assets</span>
        <Icon
          name="tabler:search"
          class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
        />
        <input
          type="search"
          data-asset-search
          placeholder="Search asset…"
          autocomplete="off"
          class="w-full rounded-lg border border-slate-200 bg-slate-50 py-2 pl-9 pr-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 dark:border-slate-700 dark:bg-slate-800 dark:text-white"
        />
      </label>
      {
        moreGroups.map((group) => (
          <div class="mt-4" data-asset-group>
            <p class="mb-2 text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">
              {group.title}
            </p>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
              {group.items.map((asset) => (
                <AssetChip
                  asset={asset}
                  size="sm"
                  data-asset-pick
                  data-symbol={asset.symbol}
                  data-name={asset.name}
                  class="w-full"
                />
              ))}
            </div>
          </div>
        ))
      }
      <p data-asset-none hidden class="mt-4 text-center text-sm text-slate-500 dark:text-slate-400">No assets match</p>
    </div>
  </section>

  <section class="mt-8" aria-labelledby="results-heading">
    <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 id="results-heading" class="text-lg font-bold tracking-tight text-slate-950 dark:text-white">
          Top <span data-asset-label>{defaultAsset.symbol}</span> opportunities
        </h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400" data-count>{productsLabel(defaultRows.length)}</p>
      </div>
      <button
        type="button"
        data-sort-button
        class="inline-flex w-fit items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
        aria-label="Toggle rate sort order"
      >
        <Icon name="tabler:arrows-sort" class="h-4 w-4" />
        <span data-sort-label>{sortLabel(true)}</span>
      </button>
    </div>

    <div
      class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-[0_8px_30px_rgba(15,23,42,0.04)] dark:border-slate-800 dark:bg-slate-900"
    >
      <div class="overflow-x-auto">
        <table class="w-full min-w-[930px] border-collapse text-left">
          <caption class="sr-only">
            Crypto earn rates for <span data-asset-label>{defaultAsset.symbol}</span>, sorted by yield
          </caption>
          <thead class="border-b border-slate-200 bg-slate-50/80 dark:border-slate-800 dark:bg-slate-800/50">
            <tr class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">
              <th scope="col" class="px-5 py-4">Exchange</th>
              <th scope="col" class="px-4 py-4">Asset</th>
              <th scope="col" class="px-4 py-4">APR / APY</th>
              <th scope="col" class="px-4 py-4">Product</th>
              <th scope="col" class="px-4 py-4">Term</th>
              <th scope="col" class="px-4 py-4">Conditions</th>
              <th scope="col" class="px-5 py-4 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            {
              allRows.map((row) => (
                <tr
                  data-asset={row.asset}
                  data-rate={row.rate}
                  hidden={row.asset !== defaultAsset.symbol}
                  class="group transition-colors hover:bg-emerald-50/30 dark:hover:bg-emerald-950/20"
                >
                  <th scope="row" class="px-5 py-5 font-normal">
                    <div class="flex items-center gap-3">
                      <span
                        class:list={[
                          'flex h-9 w-9 items-center justify-center rounded-full text-xs font-extrabold',
                          row.markClass,
                        ]}
                        aria-hidden="true"
                      >
                        {row.mark}
                      </span>
                      <span class="font-bold text-slate-900 dark:text-white">{row.exchange}</span>
                    </div>
                  </th>
                  <td class="px-4 py-5">
                    <span class="rounded-md bg-slate-100 px-2 py-1 text-xs font-bold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                      {row.asset}
                    </span>
                  </td>
                  <td class="px-4 py-5">
                    <YieldBadge rate={row.rate} type={row.type} isPromotional={row.promotional} size="md" />
                  </td>
                  <td class="px-4 py-5">
                    <span class="font-semibold text-slate-800 dark:text-slate-200">{row.product}</span>
                  </td>
                  <td class="px-4 py-5">
                    <span class="text-sm text-slate-600 dark:text-slate-400">{row.term}</span>
                  </td>
                  <td class="px-4 py-5">
                    <span class="inline-flex flex-col gap-0.5 rounded-lg bg-slate-50 px-3 py-2 text-xs font-semibold leading-4 text-slate-700 ring-1 ring-inset ring-slate-200 dark:bg-slate-800/60 dark:text-slate-300 dark:ring-slate-700">
                      <span>{row.conditionTop}</span>
                      <span class="text-slate-500 dark:text-slate-400">{row.conditionBottom}</span>
                    </span>
                  </td>
                  <td class="px-5 py-5 text-right">
                    <a
                      href={`#offer-${row.id}`}
                      class="inline-flex items-center gap-1.5 rounded-lg bg-slate-950 px-3.5 py-2.5 text-sm font-bold text-white transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500/40 dark:bg-white dark:text-slate-950 dark:hover:bg-emerald-400"
                    >
                      <span>View offer</span>
                      <Icon name="tabler:external-link" class="h-3.5 w-3.5" />
                    </a>
                  </td>
                </tr>
              ))
            }
            <tr data-empty hidden={defaultRows.length > 0}>
              <td colspan="7" class="px-5 py-10 text-center text-sm text-slate-500 dark:text-slate-400">
                No <span data-asset-label>{defaultAsset.symbol}</span> offers listed yet — more assets are coming soon.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <div
        class="flex items-start gap-2 border-t border-slate-100 bg-slate-50/50 px-5 py-3.5 text-xs leading-5 text-slate-500 dark:border-slate-800 dark:bg-slate-800/30 dark:text-slate-400"
      >
        <Icon name="tabler:info-circle" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-slate-400" />
        <p>
          Sample rates for preview only — not live data. Rates are indicative and may vary by region, account tier, and
          platform terms. Always review the offer details before depositing. Not financial advice.
        </p>
      </div>
    </div>
  </section>
</yb-yield-rates>

<style>
  yb-yield-rates {
    display: block;
  }
</style>

<script>
  import { filterAssets, productsLabel, ratesForAsset, sortLabel } from '~/utils/yields';

  class YbYieldRates extends HTMLElement {
    connectedCallback() {
      const tbody = this.querySelector('tbody');
      const empty = this.querySelector<HTMLTableRowElement>('[data-empty]');
      if (!tbody || !empty) return;

      const buttons = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-asset-button]'));
      const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr[data-asset]')).map((el) => ({
        el,
        asset: el.dataset.asset ?? '',
        rate: Number(el.dataset.rate),
      }));

      let asset = this.dataset.defaultAsset ?? '';
      let descending = true;

      const render = () => {
        const visible = ratesForAsset(rows, asset, descending);
        rows.forEach((row) => (row.el.hidden = true));
        visible.forEach((row) => {
          row.el.hidden = false;
          tbody.insertBefore(row.el, empty);
        });
        empty.hidden = visible.length > 0;

        this.querySelectorAll('[data-asset-label]').forEach((label) => (label.textContent = asset));
        const count = this.querySelector('[data-count]');
        if (count) count.textContent = productsLabel(visible.length);
        const sort = this.querySelector('[data-sort-label]');
        if (sort) sort.textContent = sortLabel(descending);
        buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.symbol === asset)));
      };

      const select = (symbol: string) => {
        asset = symbol;
        render();
      };

      buttons.forEach((button) => button.addEventListener('click', () => select(button.dataset.symbol ?? asset)));
      this.querySelector('[data-sort-button]')?.addEventListener('click', () => {
        descending = !descending;
        render();
      });

      this.setupMoreAssets(select);
    }

    /** "···" popover: search, pick an asset, show it as the extra chip after the main row. */
    private setupMoreAssets(select: (symbol: string) => void) {
      const popover = this.querySelector<HTMLElement>('#more-assets');
      const trigger = this.querySelector<HTMLButtonElement>('[data-more-button]');
      const search = this.querySelector<HTMLInputElement>('[data-asset-search]');
      if (!popover || !trigger || !search) return;

      const picks = Array.from(popover.querySelectorAll<HTMLButtonElement>('[data-asset-pick]'));
      const items = picks.map((el) => ({ el, symbol: el.dataset.symbol ?? '', name: el.dataset.name ?? '' }));
      const extras = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-extra]'));
      const groups = Array.from(popover.querySelectorAll<HTMLElement>('[data-asset-group]'));
      const none = popover.querySelector<HTMLElement>('[data-asset-none]');

      const applySearch = () => {
        const matches = new Set(filterAssets(items, search.value).map((item) => item.el));
        items.forEach((item) => (item.el.hidden = !matches.has(item.el)));
        groups.forEach((group) => (group.hidden = !group.querySelector('[data-asset-pick]:not([hidden])')));
        if (none) none.hidden = matches.size > 0;
      };

      // Popovers render in the top layer, so place it under the trigger ourselves
      // (kept on screen, flipped above the trigger when there is no room below).
      const place = () => {
        const gap = 8;
        const margin = 16;
        const anchor = trigger.getBoundingClientRect();
        const { offsetWidth: width, offsetHeight: height } = popover;
        const left = Math.min(Math.max(anchor.right - width, margin), window.innerWidth - width - margin);
        const below = anchor.bottom + gap;
        const top = below + height > window.innerHeight - margin ? Math.max(margin, anchor.top - height - gap) : below;
        popover.style.left = `${left}px`;
        popover.style.top = `${top}px`;
      };

      popover.addEventListener('toggle', (event) => {
        if ((event as ToggleEvent).newState === 'open') {
          place();
          search.focus();
          window.addEventListener('resize', place);
          window.addEventListener('scroll', place, { passive: true });
        } else {
          search.value = '';
          applySearch();
          window.removeEventListener('resize', place);
          window.removeEventListener('scroll', place);
        }
      });

      search.addEventListener('input', applySearch);
      search.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter') return;
        event.preventDefault();
        popover.querySelector<HTMLButtonElement>('[data-asset-pick]:not([hidden])')?.click();
      });

      picks.forEach((pick) =>
        pick.addEventListener('click', () => {
          const symbol = pick.dataset.symbol ?? '';
          extras.forEach((chip) => (chip.hidden = chip.dataset.symbol !== symbol));
          select(symbol);
          popover.hidePopover();
          extras.find((chip) => !chip.hidden)?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        })
      );
    }
  }

  if (!customElements.get('yb-yield-rates')) {
    customElements.define('yb-yield-rates', YbYieldRates);
  }
</script>
