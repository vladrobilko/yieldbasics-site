---
import type { HTMLAttributes } from 'astro/types';
import { Icon } from 'astro-icon/components';
import YieldBadge from '~/components/ui/YieldBadge.astro';
import { platformSlug, type Platform } from '~/data/platforms';
import { getPermalink } from '~/utils/permalinks';
import { assets } from '~/data/yields';
import { formatRateDate, type RateRow } from '~/utils/rates';

// One offer in a rates table (home page, /rates/<coin> and /platforms/<slug>). Extra
// attributes (data-*, hidden…) pass through to the <tr>. Below the lg
// breakpoint the row is laid out as a card (a two-column grid: platform and
// rate, product and term, then conditions and the button at full width), so
// phones see the whole offer without scrolling sideways. The table's <thead>
// is hidden there to match.
export interface Props extends HTMLAttributes<'tr'> {
  row: RateRow & { platform: Platform };
  /**
   * What the first column shows: the platform, linked to its page (home and
   * coin pages), or the coin (on a platform's own page).
   */
  lead?: 'platform' | 'coin';
}

const { row, lead = 'platform', ...attrs } = Astro.props;
const coin = assets.find((asset) => asset.symbol === row.asset);
---

<tr
  class="group grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-3 px-4 py-4 transition-colors hover:bg-emerald-50/30 lg:table-row lg:p-0 dark:hover:bg-emerald-950/20"
  {...attrs}
>
  <th scope="row" class="font-normal lg:table-cell lg:px-5 lg:py-5">
    {
      lead === 'platform' ? (
        <a
          href={getPermalink(`/platforms/${platformSlug(row.platform)}`)}
          class="group/brand flex w-fit items-center gap-3"
        >
          {row.platform.logo ? (
            <span
              class="h-9 w-9 shrink-0 overflow-hidden rounded-full ring-1 ring-slate-200 dark:ring-slate-700"
              aria-hidden="true"
            >
              <Icon name={row.platform.logo} class="h-full w-full" />
            </span>
          ) : (
            <span
              class:list={[
                'flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-xs font-extrabold',
                row.platform.markClass,
              ]}
              aria-hidden="true"
            >
              {row.platform.mark}
            </span>
          )}
          <span class="text-lg font-bold text-slate-900 decoration-2 underline-offset-4 group-hover/brand:underline dark:text-white">
            {row.platform.name}
          </span>
        </a>
      ) : (
        <span class="flex w-fit items-center gap-3">
          {coin?.logo ? (
            <span class="h-9 w-9 shrink-0 overflow-hidden rounded-full" aria-hidden="true">
              <Icon name={coin.logo} class="h-full w-full" />
            </span>
          ) : (
            <span
              class:list={[
                'flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-xs font-extrabold text-white',
                coin?.colorClass,
              ]}
              aria-hidden="true"
            >
              {coin?.icon}
            </span>
          )}
          <span class="text-lg font-bold text-slate-900 dark:text-white">{row.asset}</span>
        </span>
      )
    }
  </th>
  <td class="justify-self-end lg:table-cell lg:px-4 lg:py-5">
    <YieldBadge
      rate={row.rate}
      type={row.type}
      isPromotional={row.promotional || row.audience === 'new-user'}
      promoLabel={row.audience === 'new-user' ? 'New users' : 'Promo'}
      size="md"
      plain
    />
  </td>
  <td class="min-w-0 lg:table-cell lg:px-4 lg:py-5">
    <span class="block font-semibold text-slate-800 dark:text-slate-200">{row.product}</span>
    {
      (row.stale || row.source === 'manual') && (
        <span
          class="mt-1 inline-flex items-center gap-1 text-[11px] font-medium text-amber-700 dark:text-amber-400"
          title={row.source === 'manual' ? 'Checked by hand on the platform' : 'Could not refresh this rate recently'}
        >
          <Icon name="tabler:clock" class="h-3 w-3" />
          Checked {formatRateDate(row.updatedAt)}
        </span>
      )
    }
  </td>
  <td class="justify-self-end lg:table-cell lg:px-4 lg:py-5">
    <span class="text-sm text-slate-600 dark:text-slate-400">{row.term}</span>
  </td>
  <td class="col-span-2 lg:table-cell lg:px-4 lg:py-5">
    <span class="flex flex-col gap-0.5 text-sm font-semibold leading-5 text-slate-700 dark:text-slate-300">
      <span>{row.conditionTop}</span>
      <span class="text-slate-500 dark:text-slate-400">{row.conditionBottom}</span>
    </span>
  </td>
  <td class="col-span-2 lg:table-cell lg:px-5 lg:py-5">
    <a
      href={row.platform.referralUrl}
      target="_blank"
      rel="sponsored nofollow noopener"
      aria-label={`View ${row.product} offer on ${row.platform.name} (opens in a new tab)`}
      class="flex items-center justify-center gap-1.5 rounded-lg bg-slate-950 px-6 py-2.5 text-sm font-bold text-white transition hover:bg-emerald-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500/50 focus-visible:ring-offset-2 dark:bg-white dark:text-slate-950 dark:hover:bg-emerald-400 dark:focus-visible:ring-offset-slate-900 lg:inline-flex lg:w-full xl:w-40"
    >
      <span>View offer</span>
      <Icon name="tabler:external-link" class="h-3.5 w-3.5" />
    </a>
  </td>
</tr>
